# Obrigatórias
MEDULAR_API_KEY=

# Google: use UMA das duas formas.
# (a) Conta de serviço (recomendada): o JSON cru (começando com {) ou o arquivo inteiro em base64
GOOGLE_SERVICE_ACCOUNT_JSON=
# (b) OAuth de usuário: o refresh token sai de "npm run gerar-token"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Opcionais (os valores abaixo são os padrões)
MEDULAR_API_URL=https://medular.atenderbem.com/int/getPipeOpportunities
MEDULAR_QUEUE_ID=25
SPREADSHEET_ID=17VKwnesDgkPYrres2DFyE4oxLlt7qX3DNzZTcGQDgOE
# Se definido, POST /sync e POST /sync/:pipeline exigem o header x-sync-token com este valor
SYNC_TOKEN=
CRON_SCHEDULE=0 5,14 * * *
TZ_APP=America/Sao_Paulo
PORT=3000
